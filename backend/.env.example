# SmartFlow Environment Variables
PROJECT_NAME="SmartFlow - Intelligent Traffic Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="smartflow-super-secret-jwt-key-2026-traffic-ai"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="smartflow_traffic_db"

# Geofence & Virtual Signal Timings (Seconds & Meters)
DEFAULT_DETECTION_RADIUS_METERS=500
INNER_ZONE_RADIUS_METERS=150
MID_ZONE_RADIUS_METERS=300
MIN_GREEN_DURATION=10
MAX_GREEN_DURATION=55
YELLOW_DURATION=4
ALL_RED_DURATION=2
STARVATION_THRESHOLD_SECONDS=60

